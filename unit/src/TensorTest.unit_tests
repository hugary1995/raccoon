[Tests]
  design = 'constitutive_models.md'
  issues = '#28'

  [inverse]
    type = GoogleTest
    unit_test = TensorTest.inverse
    requirement = 'The system shall correctly invert a symmetric isotropic rank-four elasticity '
                  'tensor, recovering strain from stress through the tensor inverse and through '
                  'the closed-form isotropic compliance relation expressed in terms of the bulk '
                  'and shear moduli.'
  []
[]
